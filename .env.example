# ---------- AI (rewrite + headline) ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ---------- Source: RSS (recommended) ----------
# comma-separated feeds
# tested & working (bari images dete hain). BBC/Al Jazeera test mein fail hue - README dekho
RSS_FEEDS=https://feeds.skynews.com/feeds/rss/world.xml,https://www.theguardian.com/world/rss,https://rss.dw.com/rdf/rss-en-world

# ---------- Source: Apify (optional) ----------
APIFY_TOKEN=
APIFY_ACTOR=apify~facebook-posts-scraper
APIFY_PAGE_URL=

# ---------- Facebook Page ----------
FB_PAGE_ID=
FB_PAGE_TOKEN=
FB_API_VERSION=v26.0

# ---------- Branding ----------
# caption/headline kis zubaan mein (English, Urdu, Roman Urdu...)
POST_LANGUAGE=English

BRAND_HANDLE=@safucrypto
BRAND_ACCENT=#31D6E8
CARD_TEMPLATE=classic
# doosri alag tasveer mile to overlay par gol inset lagaye (0 = band)
CARD_INSET=1
CARD_WIDTH=1080
CARD_HEIGHT=1350
MAX_PER_RUN=1
