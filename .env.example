# ---------- AI (rewrite + headline) ----------
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-3.1-flash-lite-preview,gemini-flash-latest

# ---------- Source: RSS (recommended) ----------
# comma-separated feeds
# tested: Sky(1920px images, article 403 to caption chhoti) | Guardian(700px, poora article)
# Guardian US politics + NPR = Trump coverage | Politico chhora: rss sirf 29 chars deta hai
RSS_FEEDS=https://feeds.skynews.com/feeds/rss/world.xml,https://www.theguardian.com/world/rss,https://www.theguardian.com/us-news/us-politics/rss,https://feeds.npr.org/1014/rss.xml,https://rss.dw.com/rdf/rss-en-world

# ---------- Source: Apify (optional) ----------
APIFY_TOKEN=
APIFY_ACTOR=apify~facebook-posts-scraper
APIFY_PAGE_URL=

# ---------- Facebook Page ----------
FB_PAGE_ID=
FB_PAGE_TOKEN=

# --- sirf ek dafa ke setup ke liye (node scripts/fb-setup.mjs) ---
# App dashboard -> Settings -> Basic
FB_APP_ID=
FB_APP_SECRET=
# Graph API Explorer ka User Token
FB_USER_TOKEN=
FB_API_VERSION=v26.0

# ---------- Branding ----------
# caption/headline kis zubaan mein (English, Urdu, Roman Urdu...)
POST_LANGUAGE=English

BRAND_HANDLE=@safucrypto
BRAND_ACCENT=#31D6E8
# accent lafz par icy texture: ice | none
# card ke neeche handle aur source ka text: 1 = dikhao, 0 = bilkul nahi
CARD_FOOTER=0
CARD_TEXTURE=ice
CARD_TEMPLATE=classic
# doosri alag tasveer mile to overlay par gol inset lagaye (0 = band)
CARD_INSET=1
CARD_WIDTH=1080
CARD_HEIGHT=1350
MAX_PER_RUN=1

# --- rozana ka schedule ---
# din mein kitni posts (Raza Samo ~24 karta hai)
# oopri had — hadaf nahi. Taza khabrein utni hi jitni milen.
POSTS_PER_DAY=18
# is se purani khabar post nahi hogi
MAX_AGE_HOURS=8
# itni taza khabron ka jhund ho to ek run mein zyada post
BURST_HOURS=2
# do posts ke darmiyan kam se kam waqfa — is se tez kabhi nahi
MIN_GAP_MINUTES=20
# GitHub ka cron ticks girata hai — pichra kaam pakarne ke liye ek run mein itni posts tak
CATCHUP_MAX=3
# ek run ki posts ke darmiyan waqfa (seconds)
SPACING_SECONDS=90
# out/ ki files kitne din rakhein
KEEP_DAYS=7

# in mauzu ki khabrein pehle uthao (comma se alag, khaali = koi tarjeeh nahi)
PRIORITY_KEYWORDS=trump,white house,maga,republican,democrat,congress,supreme court,pentagon,elon musk
